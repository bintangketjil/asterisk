#!/bin/env bash

declare -A groups

TARGET="$1"
OUTPUT="assets/static/css/fonts.css"

if [ ! -d "$TARGET" ]; then
	echo "Dir not found"
	exit 1
fi

for filename in "$TARGET"/*.{ttf,otf,woff,woff2}; do
    [ -e "$filename" ] || continue

    path="$filename"
    filename=$(basename -- "$path")
    
    base="${filename%.*}"
    variant="${base##*-}"
    family="${base%-*}"
    format="${filename##*.}"

    if [[ "$family" == "$base" ]]; then
	family="$base"
	variant="Regular"
    fi

    weight=400
    style=normal

    [[ "$variant" == *Italic ]] && {
	style=italic
	variant=${variant%Italic}
    }

    variant=${variant%Text}

    case "${variant,,}" in
	""|regular) weight=400 ;;
	thin) weight=100 ;;
	ultralight|extralight) weight=200 ;;
	light) weight=300 ;;
	book) weight=350 ;;
	medium) weight=500 ;;
	semibold|demibold) weight=600 ;;
	bold) weight=700 ;;
	ultrabold|extrabold) weight=800 ;;
	black|heavy) weight=900 ;;
    esac

    case "${format,,}" in
	woff2)
	    priority=1
	    css_format="woff2"
	    ;;
	woff)
	    priority=2
	    css_format="woff"
	    ;;
	ttf)
	    priority=3
	    css_format="truetype"
	    ;;
	otf)
	    priority=4
	    css_format="opentype"
	    ;;
    esac

    key="${family}|${weight}|${style}"
    src="url('/$TARGET/$filename') format('$format')"

    record="${priority}|url('/${TARGET}/${filename}') format('${css_format}')"
    groups["$key"]+="$record"$'\n'
done

> "$OUTPUT"

echo "/* generated by 2fontface */" >> "$OUTPUT"
echo "" >> "$OUTPUT"

for key in $(printf "%s\n" "${!groups[@]}" | sort); do
    IFS='|' read -r family weight style <<< "$key"

    {
	echo "@font-face {"
	echo "    font-family: '${family}';"
	echo "    src:"

	mapfile -t lines < <(
	    printf "%s" "${groups[$key]}" |
		sort -t'|' -k1,1n
	)

	for ((i=0; i<${#lines[@]}; i++)); do
	    src="${lines[$i]#*|}"

	    if (( i == ${#lines[@]} - 1 )); then
		echo "        $src;"
	    else
		echo "        $src,"
	    fi
	done

	echo "    font-weight: ${weight};"
	echo "    font-style: ${style};"
	echo "    font-display: swap;"
	echo "}"
	echo
    } >> "$OUTPUT"
done
