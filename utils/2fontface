#!/bin/env bash

set -uo pipefail

VERBOSE=0
DRY_RUN=0

while [[ $# -gt 2 ]]; do
    case "$1" in
	--verbose|-v)
	    VERBOSE=1
	    ;;
	--dry-run|-n)
	    DRY_RUN=1
	    ;;
    esac

    shift
done

TARGET="$1"
OUTPUT="$2"

is_assoc() {
    local decl
    
    decl=$(declare -p "$1" 2>/dev/null) || return 1

    [[ "$decl" == "declare -A"* ]]
}


is_array() {
    local decl
    
    decl=$(declare -p "$1" 2>/dev/null) || return 1

    [[ "$decl" == "declare -a"* ]]
}


discover_fonts() {
    local root="$1"
    fonts=()

    if [[ ! -e "$root" ]]; then
	echo "error: $root: No such file or directory"
	return
    fi
    
    local cmd=(
	find
	"$root"
	-type f
	-regextype posix-extended
	-iregex '.*\.(woff2|woff|otf|ttf)$'
	-print0
    )

    mapfile -d '' fonts < <("${cmd[@]}")

    if [[ "${#fonts[@]}" -lt 1 ]]; then
	log_err "could not find any fonts in this directory"
	return
    fi
    echo "  ${#fonts[@]} font files found in '$root'"
    return
}

parse_font() {
    local font="$1"

    filename=$(basename -- "$font")
    name="${filename%.*}"
    family="${name%-*}"
    variant="${name##*-}"
    format="${filename##*.}"

    weight=400
    style=normal
    stretch=normal
    variable=false
    

    if [[ "$family" == "$name" ]]; then
	family="$name"
	variant="Regular"
    fi
	

    # style
    case "$variant" in
	*Italic)
	    style=italic
	    variant="${variant%Italic}"
	    ;;
	*Oblique)
	    style=oblique
	    variant="${variant%Oblique}"
	    ;;
    esac

    # stretch
    case "$variant" in
	*SemiCondensed)
	    stretch=semi-condensed
	    variant="${variant%SemiCondensed}"
	    ;;
	*Condensed)
	    stretch=condensed
	    variant="${variant%Condensed}"
	    ;;
	*Expanded)
	    stretch=expanded
	    variant="${variant%Expanded}"
	    ;;
    esac

    # variable
    case "$variant" in
	*Variable*|*\[wght\]*)
	    variable=true
	    variant=$(printf '%s' "$variant" | sed 's/\[[^]]*\]//g')
	    ;;
    esac

    # weight
    case "${variant,,}" in
	""|regular)
	    weight=400
	    ;;
	thin)
	    weight=100
	    ;;
	ultralight|extralight)
	    weight=200
	    ;;
	light)
	    weight=300
	    ;;
	book)
	    weight=350
	    ;;
	text)
	    weight=450
	    ;;
	medium)
	    weight=500
	    ;;
	semibold|demibold)
	    weight=600
	    ;;
	bold)
	    weight=700
	    ;;
	ultrabold|extrabold)
	    weight=800
	    ;;
	black|heavy)
	    weight=800
	    ;;
    esac

    info "Looking at $filename"
    info "- Name: $name"
    info "- Family: $family"
    info "- Style: $style"
    info "- Stretch: $stretch"
    info "- Weight: $weight"
    info "- Format: $format"
}

group_font() {
    local font="$1"

    format_priority=0
    render_priority=0
    style_priority=0

    case "${format,,}" in
	woff2)
	    format_priority=1
	    css_format="woff2"
	    ;;
	woff)
	    format_priority=2
	    css_format="woff"
	    ;;
	ttf)
	    format_priority=3
	    css_format="truetype"
	    ;;
	otf)
	    format_priority=4
	    css_format="opentype"
	    ;;
    esac
    

    case "$variant" in
	*Regular|*Roman)
	    render_priority=1
	    ;;
	""|*Italic)
	    render_priority=2
	    ;;
	*)
	    render_priority=3
	    ;;
    esac

    
    case "$style" in
	normal)
	    style_priority=1
	    ;;
	italic)
	    style_priority=2
	    ;;
	oblique)
	    style_priority=3
	    ;;
    esac
    
    css_path="/static/fonts"
    font_key="$family|$style_priority|$weight|$style|$stretch"
    font_src="url('$css_path/$filename') format('$css_format')"
    source="$format_priority|$render_priority|$font_src|$filename"

    groups["$font_key"]+="$source"$'\n'

    info "Format priority: ${format_priority} Style priority: ${style_priority} Render priority: ${render_priority}"
    info "font key: $font_key"
    info "font face: $source"

    ((font_count++))
}

emit_fonts() {
    mapfile -t keys < <(
	printf '%s\n' "${!groups[@]}" |
	    sort -t'|' -k1,1 -k2,2n -k3,3n -k4,4
    )
    cat >&3 <<EOF
/*
 * Generated by 2fontface
 * Do not edit manually
 */

EOF

    for key in "${keys[@]}"; do
	local family weight style stretch

        IFS='|' read -r family style_priority weight style stretch <<< "$key"

        {
            echo "@font-face {"
            echo "    font-family: '$family';"
            echo "    font-style: $style;"
            echo "    font-weight: $weight;"
            echo "    font-stretch: $stretch;"
            echo "    font-display: swap;"
            echo "    src:"

            mapfile -t sources < <(
                printf '%s' "${groups[$key]}" |
                    sort -t'|' -k1,1n -k2,2n -k3,3n
            )

            for ((i = 0; i < ${#sources[@]}; i++)); do
                local format_priority style_priority render_priority
                local src filename

                IFS='|' read -r \
                   format_priority \
                   render_priority \
                   src \
                   filename <<< "${sources[$i]}"

                if (( i == ${#sources[@]} - 1 )); then
                    echo "        $src;"
                else
                    echo "        $src,"
                fi
            done

            echo "}"
            echo
        } >&3
    done

}

info() {
    if (( VERBOSE )); then
	echo "${@:-}" >&2
    fi
}


log_err() {
    local script="${BASH_SOURCE[0]##*/}"
    local line_num="${BASH_LINENO[0]}"
    echo "${script}:${line_num}: $*" >&2
}


# begin
if (( DRY_RUN )); then
    exec 3>&1
else
    exec 3>"$OUTPUT"
fi


if [[ ! -e "$TARGET" ]]; then
	echo "Dir not found"
	exit 1
fi

declare -A groups
declare -A family_count
declare -i font_count=0

echo
echo "+ DISCOVER FONTS"

if ! discover_fonts "$TARGET"; then
    echo "could not find any fonts in this directory"
else
    echo
    echo "+ PARSE & GROUP FONTS"
    for font in "${fonts[@]}"; do
	parse_font "$font"
	group_font "$font"
    done

    for key in "${!groups[@]}"; do
	family=${key%%|*}

	count="${family_count[$family]:-0}"
	count=$((count + 1))
	family_count["$family"]="$count"
    done

    printf '%s\n' "  + font ($font_count files)"
    
    for family in "${!family_count[@]}"; do
	face_count="${family_count[$family]}"
	printf '    - %s (%d faces)\n' "$family" "$face_count"
    done

    echo
    echo "+ EMIT FONT-FACE"
    echo "  emitting ${#groups[@]} font-face rules to '$OUTPUT'"
    emit_fonts
fi
