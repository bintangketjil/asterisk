#!/usr/bin/env bash

VERBOSE=0
ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
	--verbose|-v)
	    VERBOSE=1
	    ;;
	"clean")
	    build_clean
	    ;;
	*)
	    ARG="$1"
	    ;;
    esac

    shift
done

if (( VERBOSE )); then
    set -xe
else
    set -Eeuo pipefail
fi


build_clean() {
    if [ -d "$BUILD" ]; then
	if rm -rf "$BUILD"; then
	    echo "[artifact] '$BUILD' dir removed"
	    exit 0
	else
	    exit "[ERROR] cannot remove '$BUILD' dir ..."
	    exit 1
	fi
    else
	echo "[SKIP] '$BUILD' dir was already removed"
	exit 0
    fi
}

discover_files() {
    ROOT="${1:-content}"

    if [[ ! -d "$ROOT"  ]]; then
	echo "error: directory not found: $ROOT" >&2
	exit 1
    fi

    find "$ROOT" -type f -name '*.md' -print
}

build_assets() {
    echo "[artifact] copy '$ASSETS' to '$ASSETS_OUT'"

    if [ -d "$ASSETS" ]; then
	mkdir -p "$ASSETS_OUT"
	cp -ruT "$ASSETS" "$ASSETS_OUT/static"
    fi
}

render() {
    input="$1"
    output="$2"
    template="$3"
    filter="$4"
    shift 4
    
    echo "[artifact] generate $output"

    "$PANDOC" "$PANDOC_COMMON" \
	      "$input" \
	      --template="$template" \
	      -o "$output" \
	      --lua-filter="$filter" \
	      "$@"
}



# config

export PANDOC_DATA_DIR="templates"

BUILD="build"
TEMPLATE="templates"


exit 0


# begin

if [ ! -d "$BUILD" ]; then
    echo "[artifact] create '$BUILD' directory"
    mkdir -p "$BUILD"
fi


build_assets

render "$MAIN_HEADER_SRC" \
       "$MAIN_HEADER_OUT" \
       "$TEMPLATES/header.html" \
       "$FILTER/unwrapper.lua" \

render "$INDEX_SRC" \
       "$INDEX_OUT" \
       "$BASE_TEMPL" \
       "$FILTER/unwrapper.lua" \
       "--lua-filter=$FILTER/element.lua"
