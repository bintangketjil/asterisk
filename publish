#!/usr/bin/env bash

# prototype for artifact
# building side


build_clean() {
    if [ -d "$BUILD" ]; then
	if rm -rf "$BUILD"; then
	    echo "[artifact] '$BUILD' dir removed"
	    exit 0
	else
	    exit "[ERROR] cannot remove '$BUILD' dir ..."
	    exit 1
	fi
    else
	echo "[SKIP] '$BUILD' dir was already removed"
	exit 0
    fi
}


discover_files() {
    ROOT="${1:-content}"

    if [[ ! -d "$ROOT"  ]]; then
	echo "error: directory not found: $ROOT" >&2
	exit 1
    fi

    find "$ROOT" -type f -name '*.md' -print
}


build_assets() {
    echo "[artifact] copy '$ASSETS' to '$ASSETS_OUT'"

    if [ -d "$ASSETS" ]; then
	mkdir -p "$ASSETS_OUT"
	cp -ruT "$ASSETS" "$ASSETS_OUT"
    fi
}


is_assoc() {
    local decl
    
    decl=$(declare -p "$1" 2>/dev/null) || return 1

    [[ "$decl" == "declare -A"* ]]
}


is_array() {
    local decl
    
    decl=$(declare -p "$1" 2>/dev/null) || return 1

    [[ "$decl" == "declare -a"* ]]
}


generate() {
    local input="$1"
    shift
    
    if is_assoc "$input"; then
	declare -n page="$input"
	
	local cmd=(
	    pandoc
	    "${page[src]}"
	    -o "${page[out]}"
	)

	if [[ ${page[standalone]:-} == true ]]; then
	    cmd+=(--standalone)
	fi

	[[ ${page[templ]+_} ]] && cmd+=(--template="${page[templ]}")


	if [[ ${page[filters]+_} ]]; then
	    declare -n filters="${page[filters]}"
	    
	    for filter in "${filters[@]}"; do
		cmd+=(--lua-filter="$filter")
	    done
	fi

	"${cmd[@]}"

	echo "[artifact] generate ${page[out]}"
	
    elif is_array "$input"; then
	declare -n items="$input"
	
	for item in "${items[@]}"; do
	    generate "$item"
	done

    else
	pandoc "$input" "$@"

	echo "[artifact] generate $input"
    fi
}


## config 

export PANDOC_DATA_DIR="templates"

BUILD="build"
ASSETS="assets"
ASSETS_OUT="build/assets/static"

base_filters=(
    "lib/filter/unwrapper.lua"
)
page_filters=(
    "lib/filter/unwrapper.lua"
    "lib/filter/element.lua"
)

declare -A header_root=(
    [src]="content/partials/header.md"
    [out]="templates/partials/gen-header.html"
    [templ]="templates/header.html"
    [filters]="base_filters"
)

declare -A header_writings=(
    [src]="content/partials/header-writings.md"
    [out]="templates/partials/gen-header-writings.html"
    [templ]="templates/header.html"
    [filters]="base_filters"
)

declare -A index_root=(
    [src]="content/pages/index.md"
    [out]="build/index.html"
    [templ]="templates/base.html"
    [filters]="page_filters"
    [standalone]=true
)

declare -A index_writings=(
    [src]="content/pages/writings.md"
    [out]="build/writings/index.html"
    [templ]="templates/writings.html"
    [filters]="page_filters"
)

partials=(
    header_root
    header_writings
)

pages=(
    index_root
    index_writings
)


## begin

VERBOSE=0
ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
	--verbose|-v)
	    VERBOSE=1
	    ;;
	clean)
	    build_clean
	    ;;
	*)
	    ARG="$1"
	    ;;
    esac

    shift
done

if (( VERBOSE )); then
    set -xe
else
    set -Eeuo pipefail
fi

if [ ! -d "$BUILD" ]; then
    echo "[artifact] create '$BUILD' directory"
    mkdir -p "$BUILD"
fi


build_assets

generate partials

generate pages
