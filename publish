#!/usr/bin/env bash


VERBOSE=0
ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
	--verbose|-v)
	    VERBOSE=1
	    ;;
	*)
	    ARG="$1"
	    ;;
    esac

    shift
done


if (( VERBOSE )); then
    set -xe
else
    set -Eeuo pipefail
fi

export PANDOC_DATA_DIR="assets/template"

BUILD="build"
ASSETS="assets/static"
TEMPLATES="assets/templates"
PARTIALS="content/partials"
FILTER="./lib/filter"

MAIN_HEADER_SRC="$PARTIALS/header.md"
ROOTFOOTER_SRC="$PARTIALS/root-footer.md"
DEFFOOTER_SRC="$PARTIALS/footer.md"
INDEX_SRC="content/pages/index.md"
WRITINGS_SRC="content/pages/writings.md"
LOG_SRC="content/self/log.md"

MAIN_HEADER_OUT="$TEMPLATES/gen-main-header.html"
ROOTFOOTER_OUT="$TEMPLATES/root-footer.html"
DEFFOOTER_OUT="$TEMPLATES/default-footer.html"
ASSETS_OUT="$BUILD/assets"
INDEX_OUT="$BUILD/index.html"
WRITINGS_OUT="$BUILD/writings/index.html"
NOTES_OUT="$BUILD/writings/notes"
LOG_OUT="$BUILD/self/log/index.html"

FOOTER_TEMPL="$TEMPLATES/footer.html"
BASE_TEMPL="$TEMPLATES/base.html"
WRITINGS_TEMPL="$TEMPLATES/writings.html"
LOG_TEMPL="$TEMPLATES/log.html"
ARTICLE_TEMPL="$TEMPLATES/article.html"

PANDOC="pandoc"
PANDOC_COMMON="-s"



if [ "$ARG" = "clean" ]; then
    if [ -d "$BUILD" ]; then
	if rm -rf "$BUILD"; then
	    echo "[artifact] '$BUILD' dir removed"
	    exit 0
	else
	    exit "[ERROR] cannot remove '$BUILD' dir ..."
	    exit 1
	fi
    else
	echo "[SKIP] '$BUILD' dir was already removed"
	exit 0
    fi
fi

discover_files() {
    ROOT="${1:-content}"

    if [[ ! -d "$ROOT"  ]]; then
	echo "error: directory not found: $ROOT" >&2
	exit 1
    fi

    find "$ROOT" -type f -name '*.md' -print
}

build_assets() {
    echo "[artifact] copy '$ASSETS' to '$ASSETS_OUT'"

    if [ -d "$ASSETS" ]; then
	mkdir -p "$ASSETS_OUT"
	cp -ruT "$ASSETS" "$ASSETS_OUT/static"
    fi
}

render() {
    input="$1"
    output="$2"
    template="$3"
    filter="$4"
    shift 4
    
    echo "[artifact] generate $output"

    "$PANDOC" "$PANDOC_COMMON" \
	      "$input" \
	      --template="$template" \
	      -o "$output" \
	      --lua-filter="$filter" \
	      "$@"
}



if [ ! -d "$BUILD" ]; then
    echo "[artifact] create '$BUILD' directory"
    mkdir -p "$BUILD"
fi


build_assets

render "$MAIN_HEADER_SRC" \
       "$MAIN_HEADER_OUT" \
       "$TEMPLATES/header.html" \
       "$FILTER/unwrapper.lua" \

render "$INDEX_SRC" \
       "$INDEX_OUT" \
       "$BASE_TEMPL" \
       "$FILTER/unwrapper.lua" \
       "--lua-filter=$FILTER/element.lua"
