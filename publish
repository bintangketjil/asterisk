count_pages() {
    local input="$1"
    declare -i count=0

    if [ ! -v "$input" ] && ! is_assoc "$input"; then
	echo "Err: $input: No such variable or array"

    elif ! is_assoc "$input"; then
	echo "$input is not Assoc"

	declare -n input="$1"

	for i in "${input[@]}"; do
	    if ! is_assoc "$i"; then
		echo "  $i is not Assoc"
		count_pages "$i"
	    else
		echo "  $i is Assoc"
		declare -n j="$i"
		[[ "${j[out]}" ]] && count=$((count + 1))
	    fi
	done
    else
	echo "$input is Assoc"

	declare -n input="$input"

	[[ "${input[out]}" ]] && count=$((count + 1))
    fi

    echo
    echo "Output: $count"
}

