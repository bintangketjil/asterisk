#!/usr/bin/env bash

# prototype for artifact
# building side

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

build_clean() {
    if [ -d "$BUILD" ]; then
	if rm -rf "$BUILD"; then
	    echo "[remove] '$BUILD' dir"
	    exit 0
	else
	    exit "[error] cannot remove '$BUILD' dir ..."
	    exit 1
	fi
    else
	echo "[skip] '$BUILD' dir was already removed"
	exit 0
    fi
}


discover_files() {
    ROOT="${1:-content}"

    if [[ ! -d "$ROOT"  ]]; then
	echo "error: directory not found: $ROOT" >&2
	exit 1
    fi

    find "$ROOT" -type f -name '*.md' -print
}


build_assets() {
    echo "[copy] '$ASSETS' to '$ASSETS_OUT'"
    echo
    
    if [ -d "$ASSETS" ]; then
	mkdir -p "$ASSETS_OUT"
	cp -ruT "$ASSETS" "$ASSETS_OUT"
    fi
}


is_assoc() {
    local decl
    
    decl=$(declare -p "$1" 2>/dev/null) || return 1

    [[ "$decl" == "declare -A"* ]]
}


is_array() {
    local decl
    
    decl=$(declare -p "$1" 2>/dev/null) || return 1

    [[ "$decl" == "declare -a"* ]]
}


generate() {
    local input="$1"
    shift

    if [ ! -d "$BUILD" ]; then
	echo "[warning] '$BUILD' directory is not found"
	echo "[create] $BUILD"
	echo
	
	mkdir -p "$BUILD"
    fi

    if is_assoc "$input"; then
	declare -n page="$input"

	echo "[generate] $input"

	local cmd=(
	    pandoc
	    "${page[src]}"
	    -o "${page[out]}"
	)

	if [[ ${page[standalone]:-} == true ]]; then
	    cmd+=(--standalone)
	fi

	[[ ${page[templ]+_} ]] && cmd+=(--template="${page[templ]}")


	if [[ ${page[filters]+_} ]]; then
	    declare -n filters="${page[filters]}"
	    
	    for filter in "${filters[@]}"; do
		cmd+=(--lua-filter="$filter")
	    done
	fi

	local dir=$(dirname ${page[out]})

	if [[ ! -d "$dir" ]]; then
	    echo -e "${YELLOW}[warning]${NC} $dir directory is not found"
	    echo "[create] $dir"
	    echo
	    
	    # mkdir -p "$dir"
	fi
	
	# "${cmd[@]}"

	echo "+ ${page[out]}"
	echo
	
    elif is_array "$input"; then
	declare -n items="$input"
	
	for item in "${items[@]}"; do
	    generate "$item"
	done

    else
	pandoc "$input" "$@"

	echo "[artifact] generate $input"
    fi

}


