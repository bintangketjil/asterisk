## begin

VERBOSE=0
ARG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
	--verbose|-v)
	    VERBOSE=1
	    ;;
	clean)
	    build_clean
	    ;;
	*)
	    echo -e "${RED}[abort]${NC} command not found"
	    # usage
	    
	    exit 0
	    ;;
    esac

    shift
done

if (( VERBOSE )); then
    set -xe
else
    set -Eeuo pipefail
fi


